{
  "Author": "OpenCodexMicro",
  "Name": "Codex Micro",
  "Overview": "Control Codex Desktop tasks and actions from Ulanzi D200 Series in Ulanzi Studio.",
  "Description": "Control Codex Desktop from Ulanzi D200 Series through Ulanzi Studio. Five live task keys, Codex actions, encoders, and a local Bridge. Experimental Windows 10/11 support in the abartiggut fork; macOS 13+ from the original project. Setup: https://github.com/abartiggut/ulanzi/tree/windows-port#installation. Windows: npm ci; npm run setup:windows; restart Ulanzi Studio; launch or restart Codex using the Bridge action. macOS: see the original installation guide. Requires Codex Desktop and Ulanzi Studio. Only local loopback ports are used.",
  "Icon": "assets/icons/plugin.png",
  "Category": "AI",
  "CategoryIcon": "assets/icons/plugin.png",
  "Banner": [
    "assets/banners/codex-micro-banner-1.png",
    "assets/banners/codex-micro-banner-2.png",
    "assets/banners/codex-micro-banner-3.png"
  ],
  "Version": "0.5.1",
  "UUID": "com.ulanzi.ulanzistudio.codexmicro",
  "Type": "JavaScript",
  "CodePath": "dist/app.js",
  "Software": {
    "MinVersion": "3.0.1"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13.0"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
